# Mellyn Security Environment Configuration Example
# Copy to .env for local development. NEVER commit real secrets to version control.
# Gitleaks still scans this file: keep every value an obvious placeholder.
# Variable names keep the MELLYN_ prefix: it is what the mellyn package reads.

MELLYN_ENV=development

# Server-side pepper for API-key storage. Tenant API keys are high-entropy random values, so
# the database stores HMAC-SHA256(MELLYN_API_KEY_PEPPER, key) and verifies with hmac.compare_digest.
# (Passwords, which are low-entropy, use Argon2id instead.)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MELLYN_API_KEY_PEPPER=replace_with_output_of_secrets_token_urlsafe

# Authorizer API keys, stored only as HMAC-SHA256(pepper, key) digests. There are two separate keys:
# the agent harness gets the agent key; only the human approval surface gets the approver key.
# With the pepper set, run `PYTHONPATH=src python -m mellyn.credentials` once per key to get a key and its digest.
MELLYN_AGENT_KEY_DIGEST=replace_with_digest_from_mellyn_credentials
MELLYN_APPROVER_KEY_DIGEST=replace_with_digest_from_mellyn_credentials
# Optional third key digest reserved for read-only Role.VIEWER integrations. It must differ from the other two keys.
# Uncomment this only once you have a real digest. Every service checks every digest that is set, so leaving
# the placeholder active stops the authorizer and gateway from starting.
# MELLYN_VIEWER_KEY_DIGEST=replace_with_digest_from_mellyn_credentials

MELLYN_LOG_LEVEL=INFO
MELLYN_STRICT_MODE=true
MELLYN_ALLOWED_ORIGINS=http://localhost:3000
# Optional SQLite path to persist HTTP authorizer sessions, taint, and single-use grants across restarts.
# Container deployments pre-configure /var/lib/mellyn/state.db on the mellyn-authorizer-state volume.
# MELLYN_STATE_DB_PATH=./data/mellyn-state.db
